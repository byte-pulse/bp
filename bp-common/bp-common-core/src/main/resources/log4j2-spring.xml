<?xml version="1.0" encoding="utf-8" ?>
<Configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" monitorInterval="30" status="off"
               xmlns="https://logging.apache.org/xml/ns"
               xsi:schemaLocation="https://logging.apache.org/xml/ns https://logging.apache.org/xml/ns/log4j-config-2.xsd">

    <Properties>
        <Property name="LOG_DIR">.logs</Property>
    </Properties>

    <!-- 日志处理 -->
    <Appenders>
        <!-- 控制台输出 -->
        <!-- dev,test -->
        <SpringProfile name="dev,test">
            <Console name="consoleDev" target="SYSTEM_OUT">
                <PatternLayout
                        pattern="%green{%d{yyyy-MM-dd HH:mm:ss}} %magenta{[%-23t]} %magenta{[%pid]} %highlight{[%-5p]} %cyan{%logger{1.}}⤵%n%msg%n%ex%n"/>
            </Console>
            <Async name="asyncConsoleDev">
                <AppenderRef ref="consoleDev"/>
            </Async>
        </SpringProfile>
        <!-- prod -->
        <SpringProfile name="prod">
            <Console name="consoleProd" target="SYSTEM_OUT">
                <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-23t] [%pid] [%-5level] : %msg%n%ex"/>
            </Console>
            <Async name="asyncConsoleProd">
                <AppenderRef ref="consoleProd"/>
            </Async>
        </SpringProfile>

        <!-- 输出到文件 -->
        <RollingFile name="rollingFileWarn"
                     fileName="${LOG_DIR}/${spring:spring.application.name}/warn.log"
                     filePattern="${LOG_DIR}/${spring:spring.application.name}/%d{yyyy-MM-dd}/warn-%i.log">
            <!-- 过滤级别 -->
            <ThresholdFilter level="warn" onMatch="ACCEPT" onMismatch="deny"/>
            <!-- 消息格式 -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-23t] [%pid] [%-5level] : %msg%n%ex"/>
            <Policies>
                <!-- 单文件最大大小 -->
                <SizeBasedTriggeringPolicy size="10MB"/>
                <!-- 按时间滚动 -->
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/>
        </RollingFile>

        <RollingFile name="rollingFileInfo"
                     fileName="${LOG_DIR}/${spring:spring.application.name}/info.log"
                     filePattern="${LOG_DIR}/${spring:spring.application.name}/%d{yyyy-MM-dd}/info-%i.log">
            <!-- 只接收 INFO -->
            <LevelRangeFilter minLevel="info"
                              maxLevel="info"
                              onMatch="ACCEPT"
                              onMismatch="DENY"/>
            <!-- 消息格式 -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-23t] [%pid] [%-5level] : %msg%n%ex"/>
            <Policies>
                <!-- 单文件最大大小 -->
                <SizeBasedTriggeringPolicy size="10MB"/>
                <!-- 按时间滚动 -->
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/>
        </RollingFile>

        <Async name="asyncRollingFileWarn">
            <AppenderRef ref="rollingFileWarn"/>
        </Async>
        <Async name="asyncRollingFileInfo">
            <AppenderRef ref="rollingFileInfo"/>
        </Async>
    </Appenders>

    <Loggers>
        <SpringProfile name="dev,test">
            <Root level="error">
                <AppenderRef ref="asyncConsoleDev"/>
            </Root>
            <Logger name="cloud.bytepulse" level="debug" additivity="false">
                <AppenderRef ref="asyncConsoleDev"/>
            </Logger>
            <Logger name="org.springframework" level="info" additivity="false">
                <AppenderRef ref="asyncConsoleDev"/>
            </Logger>
            <Logger name="org.springframework.web.servlet.DispatcherServlet" level="warn" additivity="false">
                <AppenderRef ref="asyncConsoleDev"/>
            </Logger>
            <Logger name="org.springframework.web.servlet.mvc.method.annotation.ExceptionHandlerExceptionResolver"
                    level="error" additivity="false">
                <AppenderRef ref="asyncConsoleDev"/>
            </Logger>
        </SpringProfile>

        <SpringProfile name="prod">
            <Root level="error">
                <AppenderRef ref="asyncConsoleProd"/>
                <AppenderRef ref="asyncRollingFileWarn"/>
            </Root>
            <Logger name="cloud.bytepulse" level="info" additivity="false">
                <AppenderRef ref="asyncConsoleProd"/>
                <AppenderRef ref="asyncRollingFileWarn"/>
                <AppenderRef ref="asyncRollingFileInfo"/>
            </Logger>
        </SpringProfile>
    </Loggers>
</Configuration>